# ── 기본 ─────────────────────────────────────────
PORT=8080
# 운영 도메인 (결제 성공/실패 복귀 주소 생성에 사용)
PUBLIC_BASE_URL=http://localhost:8080
# production 이면 쿠키에 Secure 적용, 개발용 로그 비활성
NODE_ENV=development
DATABASE_PATH=./data/korean-together.db

# ── 관리자 보안 ──────────────────────────────────
# true 이면 관리자 로그인에 OTP(2단계 인증) 필수
ADMIN_REQUIRE_MFA=false

# ── 결제 ────────────────────────────────────────
# test | link | toss | eximbay
PAYMENT_MODE=test
# 토스페이먼츠 (계약 후 발급, 시크릿 키는 서버에만 보관)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 엑심베이 (계약 후 발급)
EXIMBAY_MID=
EXIMBAY_API_KEY=
# 결제 진행 중 좌석 임시 확보 시간(분)
SEAT_HOLD_MINUTES=15

# ── 이메일 ──────────────────────────────────────
# none | resend
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
