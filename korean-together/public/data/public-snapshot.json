  "faqs": [
    {
      "id": 1,
      "q": {
        "ko": "수준 확인 결과는 공식 성적인가요?",
        "en": "Is the level check an official score?"
      },
      "a": {
        "ko": "아닙니다. 사이트의 수준 확인은 과정 선택을 돕는 학습 안내용이며, 공식 한국어 능력 인증이나 시험 성적이 아닙니다.",
        "en": "No. The level check only helps you choose a course. It is not an official Korean proficiency certificate or test score."
      }
    },
    {
      "id": 2,
      "q": {
        "ko": "나이에 따라 반이 정해지나요?",
        "en": "Are classes grouped by age?"
      },
      "a": {
        "ko": "아닙니다. 한국어 수준, 학습 목적, 희망 속도를 기준으로 과정을 추천합니다.",
        "en": "No. Courses are recommended by your Korean level, learning goal and preferred pace."
      }
    },
    {
      "id": 3,
      "q": {
        "ko": "수업 시간은 어느 시간대 기준인가요?",
        "en": "Which time zone are class times in?"
      },
      "a": {
        "ko": "각 과정의 기준 시간대와 함께, 내 기기에 설정된 현지 시간으로도 표시합니다.",
        "en": "Each class shows its base time zone together with your local time."
      }
    },
    {
      "id": 4,
      "q": {
        "ko": "화상수업 링크는 어디에서 보나요?",
        "en": "Where do I find the video class link?"
